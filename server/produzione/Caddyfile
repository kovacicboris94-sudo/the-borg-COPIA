# Caddy fa da porta d'ingresso: prende da solo i certificati HTTPS (Let's Encrypt)
# e passa le richieste a Nakama (e quelle di /mcp al servizio Claude nel borgo). DOMINIO arriva da /etc/the-borg/.env.

{$DOMINIO} {
	encode gzip
	# Claude nel borgo (server MCP)
	handle /mcp* {
		reverse_proxy claude:7352
	}
	handle {
		reverse_proxy nakama:7350
	}
}

console.{$DOMINIO} {
	encode gzip
	reverse_proxy nakama:7351
}
